---
/* Horizontal lockup: mark left, wordmark right, gap = 1/3 mark width.
   Clear space 1/4 mark width all sides.

   On the dark brand the lockup uses the REVERSED monogram, not the app tile:
   the tile's Coal ground would sit on a Coal page and disappear. The tile is
   still canon — it is the app icon, where it has a home screen behind it. */
import Mark from './Mark.astro';
interface Props { reversed?: boolean; size?: number; }
const { reversed = false, size = 38 } = Astro.props;
---
<span class="lockup" style={`--tile:${size}px`}>
  <Mark variant="reversed" size={Math.round(size * 0.86)} />
  <span class="lockup__type" class:list={{ 'is-reversed': reversed }}>
    <span class="lockup__name">Front Porch</span>
    <span class="lockup__sub">Collective</span>
  </span>
</span>

<style>
  .lockup { display: inline-flex; align-items: center; gap: calc(var(--tile) / 3); }
  .lockup__type { display: grid; line-height: 1; }
  .lockup__name {
    font-family: var(--font-display); font-weight: 600;
    font-size: calc(var(--tile) * 0.52); letter-spacing: -0.01em;
  }
  .lockup__sub {
    font-family: var(--font-ui); font-weight: 400;
    font-size: calc(var(--tile) * 0.26);
    letter-spacing: 0.42em; text-transform: uppercase;
    color: var(--ash); margin-top: .32em;
  }
  .is-reversed .lockup__sub { color: var(--ash); }
</style>
