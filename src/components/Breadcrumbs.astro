---
interface Props { items: { name: string; path: string }[] }
const { items } = Astro.props;
---
<nav class="crumbs" aria-label="Breadcrumb">
  <div class="wrap">
    <ol>
      {items.map((item, i) => (
        <li>
          {i < items.length - 1
            ? <a href={item.path}>{item.name}</a>
            : <span aria-current="page">{item.name}</span>}
        </li>
      ))}
    </ol>
  </div>
</nav>
<style>
  .crumbs { border-bottom: 1px solid var(--line); background: var(--coal); }
  .crumbs ol {
    display: flex; flex-wrap: wrap; gap: .5rem; list-style: none;
    margin: 0; padding: .85rem 0; font-size: var(--step--1); color: var(--ash);
  }
  .crumbs li + li::before { content: "/"; margin-right: .5rem; color: var(--ash-dim); }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; text-decoration-color: var(--signal); }
  .crumbs [aria-current="page"] { color: var(--chalk); font-weight: 500; }
</style>
