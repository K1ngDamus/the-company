---
/* "From the Porch" — one field, embedded, on every page (§5 of the brief).
   The welcome and sales sequences are written and HELD, never sent (rule 9). */
import { FORMS, FORMS_LIVE, SITE } from '../data/site';
const live = FORMS_LIVE;
---
<section class="porch" aria-labelledby="porch-h">
  <div class="wrap porch__inner">
    <div>
      <p class="eyebrow">From the Porch</p>
      <h2 id="porch-h" style="margin-top:.7rem">One note a month. Nothing else.</h2>
      <p class="lede" style="margin-top:.9rem">
        What we built, what broke, and what it taught us — plain language, once a
        month. No drip, no pitch stack, unsubscribe in one click.
      </p>
    </div>
    <div>
      <form class="capture" method="post" action={live ? FORMS.endpoint : undefined}
            data-endpoint={live ? FORMS.endpoint : undefined}>
        <input type="hidden" name="list" value="from-the-porch" />
        {live && <input type="hidden" name="access_key" value={FORMS.accessKey} />}
        {live && <input type="hidden" name="subject" value="From the Porch — new subscriber" />}
        {live && <input type="hidden" name="from_name" value={SITE.name} />}
        <label class="visually-hidden" for="porch-email">Your email address</label>
        <input class="input" id="porch-email" type="email" name="email" placeholder="you@example.com" autocomplete="email" required />
        <input class="visually-hidden" type="checkbox" name={FORMS.honeypot} tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button class="btn" type="submit" aria-disabled={live ? undefined : 'true'} disabled={!live}>
          <span class="dot" aria-hidden="true"></span><span class="btn__label">Send it</span>
        </button>
      </form>
      <p class="porch__status" role="status" aria-live="polite" hidden></p>
      {!live && (
        <p class="small" style="margin-top:.9rem;color:var(--ash)">
          Built and staged. No list is connected, so nothing is collected or sent yet.
        </p>
      )}
    </div>
  </div>
</section>

<script>
  /* Submits in place, like the quote forms. Without JavaScript the browser
     POSTs natively and lands on the provider's page — still works, just less
     pleasant. */
  document.querySelectorAll<HTMLFormElement>('.porch form').forEach((form) => {
    const endpoint = form.dataset.endpoint;
    if (!endpoint) return;
    const status = form.parentElement?.querySelector<HTMLElement>('.porch__status');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const label = button?.querySelector<HTMLElement>('.btn__label');
    const labelText = label?.textContent ?? '';

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      /* Honeypot: bots fill it, people never see it. Matched by the hidden-
         from-people attributes rather than by name, because the name belongs
         to the form provider. `.checked`, NOT `.value` — an unchecked checkbox
         still reports value "on", so testing .value would swallow every real
         submission and show the visitor a fake success panel. */
      const trap = form.querySelector<HTMLInputElement>('input[aria-hidden="true"][tabindex="-1"]');
      if (trap?.checked) { form.hidden = true; return; }

      if (button) button.disabled = true;
      if (label) label.textContent = 'Sending…';

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!response.ok) throw new Error(`${response.status}`);
        form.hidden = true;
        if (status) {
          status.textContent = 'You are on the list. One note a month, and nothing else.';
          status.hidden = false;
        }
      } catch {
        if (status) {
          status.textContent = 'That did not send. Please try again in a moment.';
          status.hidden = false;
        }
        if (button) button.disabled = false;
        if (label) label.textContent = labelText;
      }
    });
  });
</script>

<style>
  .porch {
    padding-block: clamp(3rem, 2.2rem + 3.5vw, 5rem);
    background: var(--graphite);
    border-top: 2px solid var(--signal);
  }
  .porch__inner { display: grid; gap: 2rem; align-items: center; }
  .porch .input { background: transparent; border-color: var(--line-strong); color: var(--chalk); }
  .porch .input::placeholder { color: var(--ash); }
  .porch .input:hover { border-color: var(--ash); }
  .porch .input:focus { border-color: var(--signal); box-shadow: 0 0 0 3px var(--signal-glow); }
  .porch__status {
    margin-top: .9rem; font-size: var(--step--1); color: var(--chalk);
    border-left: 2px solid var(--signal); padding-left: .8rem;
  }
  @media (min-width: 880px) { .porch__inner { grid-template-columns: 1.1fr 1fr; gap: 4rem; } }
</style>
