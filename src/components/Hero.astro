---
import { link } from '../data/site';

/* Above the fold, every time: headline (the thesis), the one-line promise,
   the primary CTA, and the form — or, on narrow screens, its anchor.
   Nothing else earns a place up here. */
interface Props {
  eyebrow: string;
  title: string;
  promise: string;
  primary: { href: string; label: string };
  secondary?: { href: string; label: string };
  anchorNote?: string;
  wide?: boolean;
}
const { eyebrow, title, promise, primary, secondary, anchorNote, wide = false } = Astro.props;
const hasAside = Astro.slots.has('aside');
---
<section class:list={['hero', { 'hero--split': hasAside, 'hero--wide': wide }]}>
  <div class="wrap hero__inner">
    <div class="hero__copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="lede">{promise}</p>
      <p class="hero__actions">
        <a class="btn" href={link(primary.href)}><span class="dot" aria-hidden="true"></span>{primary.label}</a>
        {secondary && <a class="btn btn--ghost" href={link(secondary.href)}>{secondary.label}</a>}
      </p>
      {anchorNote && <p class="small hero__note">{anchorNote}</p>}
    </div>
    {hasAside && <div class="hero__aside"><slot name="aside" /></div>}
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 1.6rem + 4.5vw, 5.5rem) clamp(2.5rem, 1.6rem + 4vw, 5rem);
    background:
      radial-gradient(120% 90% at 88% -10%, rgba(255,77,79,.10) 0%, transparent 58%),
      var(--coal);
    border-bottom: 1px solid var(--line);
  }
  .hero h1 { margin-top: 1rem; }
  .hero .lede { margin-top: 1.35rem; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2.2rem; }
  .hero__note { margin-top: 1.1rem; }
  .hero__inner { display: grid; gap: clamp(2.5rem, 1.6rem + 3vw, 4rem); align-items: center; }
  /* `ch` resolves against the element's OWN font-size, so the measure has to
     live on the h1 — putting it on the column would size it to body text. */
  .hero--wide .hero__copy { max-width: 54rem; }
  .hero--wide h1 { max-width: 15ch; }
  .hero--wide .lede { max-width: 50ch; }
  @media (min-width: 980px) {
    .hero--split .hero__inner { grid-template-columns: 1fr 1fr; align-items: start; }
    .hero--split .hero__copy { position: sticky; top: 100px; }
  }
</style>
