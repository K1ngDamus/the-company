---
import { link } from '../data/site';

interface Props {
  eyebrow: string;
  title: string;
  href?: string;
  tags?: string[];
  featured?: boolean;
}
const { eyebrow, title, href, tags = [], featured = false } = Astro.props;
const Tag = href ? 'a' : 'div';
/* A client's live site opens in its own tab. Sending a visitor off our page to
   look at proof and making them find their way back is resistance we put in
   their way ourselves. */
const external = !!href && /^https?:/.test(href);
---
<Tag class:list={['card', 'proof', { 'proof--featured': featured, 'card--link': !!href }]} href={href && link(href)}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}>
  <p class="eyebrow">{eyebrow}</p>
  <h3 class="card__title" style="margin-top:.8rem">{title}</h3>
  <div class="proof__body"><slot /></div>
  {tags.length > 0 && (
    <p class="proof__tags">{tags.map((t) => <span class="tag">{t}</span>)}</p>
  )}
  {href && <span class="card__arrow">See the build <span aria-hidden="true">→</span></span>}
</Tag>
<style>
  .proof__body { margin-top: 1rem; color: var(--ash); }
  .proof__body :global(p) { margin-bottom: .8rem; }
  .proof__body :global(p:last-child) { margin-bottom: 0; }
  .proof__tags { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: 1.3rem; }
  .proof--featured { border-color: var(--signal); }
</style>
