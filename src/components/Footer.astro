---
import Lockup from './Lockup.astro';
import { SITE, NAV, CONTACT, NAP, COUNTIES } from '../data/site';
const year = 2026;
---
<footer class="site-footer section--deep">
  <div class="wrap">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <Lockup size={44} reversed={true} />
        <p class="small site-footer__promise">{SITE.promise}</p>
      </div>

      <div class="site-footer__cols">
        <div>
          <h2 class="site-footer__h">Services</h2>
          <ul>
            {NAV.slice(0, 5).map((i) => <li><a href={i.href}>{i.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="site-footer__h">Company</h2>
          <ul>
            <li><a href="/work">Work</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/contact">Contact</a></li>
            <li><a href="/privacy">Privacy</a></li>
            <li><a href="/terms">Terms</a></li>
          </ul>
        </div>
        <div>
          <h2 class="site-footer__h">TV mounting areas</h2>
          <ul>
            {COUNTIES.map((c) => <li><a href={`/tv-mounting/${c.slug}`}>{c.name}</a></li>)}
          </ul>
        </div>
      </div>
    </div>

    <hr class="site-footer__rule" />

    <div class="site-footer__bottom">
      <div class="site-footer__nap">
        <!-- NAP: identical wording everywhere it appears (name, area, contact).
             Service-area business — no street address is published. -->
        <p><strong>{NAP.name}</strong></p>
        <p class="small">Serving {NAP.city}, {NAP.regionName} and the metro — {COUNTIES.map((c) => c.short).join(', ')} counties.</p>
        <p class="small">
          {CONTACT.email
            ? <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
            : <span class="blank">Email — awaiting Leon</span>}
          {' · '}
          {CONTACT.phone && CONTACT.phoneHref
            ? <a href={`tel:${CONTACT.phoneHref}`}>{CONTACT.phone}</a>
            : <span class="blank">Phone — awaiting Leon</span>}
        </p>
      </div>
      <p class="small site-footer__legal">
        © {year} {SITE.legalName}. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer { padding-block: clamp(3rem, 2rem + 4vw, 5rem) 2rem; }
  .site-footer__top { display: grid; gap: 2.5rem; }
  .site-footer__promise { margin-top: 1.1rem; max-width: 34ch; }
  .site-footer__cols { display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }
  .site-footer__h {
    font-family: var(--font-ui); font-size: var(--step--1); font-weight: 500;
    letter-spacing: .16em; text-transform: uppercase; color: var(--ash);
    margin-bottom: .9rem;
  }
  .site-footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .55rem; }
  .site-footer a { text-decoration: none; font-size: var(--step--1); }
  .site-footer a:hover { text-decoration: underline; text-decoration-color: var(--signal); text-decoration-thickness: 2px; }
  .site-footer__rule { border: 0; height: 1px; background: var(--line-strong); margin-block: 2.5rem 1.75rem; }
  .site-footer__bottom { display: grid; gap: 1.25rem; }
  .site-footer__nap p { margin: 0 0 .3rem; }
  .blank { border-bottom: 2px dashed var(--signal); color: var(--ash); }
  .site-footer__legal { color: var(--ash); }
  @media (min-width: 860px) {
    .site-footer__top { grid-template-columns: 1fr 1.6fr; gap: 4rem; }
    .site-footer__bottom { grid-template-columns: 1fr auto; align-items: end; }
    .site-footer__legal { text-align: right; }
  }
</style>
