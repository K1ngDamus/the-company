---
import { FORM_ENDPOINT } from '../data/site';

/* ---------------------------------------------------------------------------
   The quote form. Playbook §2, physical resistance:
   - Embedded on the service page. Never a button to a second page.
   - Multiple choice with the likely answers bucketed. Keystrokes are added
     ONLY as a deliberate quality filter, and each one is marked below.
   - Radio select with auto-advance (progressive enhancement; works without JS).
   Rule 9: nothing sends. FORM_ENDPOINT is null, so submit is inert and the
   staging notice is visible. See FORMS.md.
   --------------------------------------------------------------------------- */
export type Field =
  | { kind: 'choice'; name: string; label: string; hint?: string; options: string[]; required?: boolean }
  | { kind: 'text' | 'email' | 'tel'; name: string; label: string; hint?: string; placeholder?: string; required?: boolean }
  | { kind: 'textarea'; name: string; label: string; hint?: string; placeholder?: string; required?: boolean };

interface Props {
  id?: string;
  service: string;      // routed with the submission
  heading: string;      // the CTA restated above the form — its own argument (§3)
  sub?: string;
  fields: Field[];
  submitLabel?: string;
}
const {
  id = 'quote',
  service,
  heading,
  sub,
  fields,
  submitLabel = 'Send my request',
} = Astro.props;

const live = FORM_ENDPOINT !== null;
---
<div class="quote" id={id}>
  <div class="quote__head">
    <h2>{heading}</h2>
    {sub && <p class="lede">{sub}</p>}
  </div>

  <form
    class="form"
    method="post"
    action={live ? FORM_ENDPOINT : undefined}
    data-endpoint={live ? FORM_ENDPOINT : undefined}
    aria-describedby={live ? undefined : `${id}-staged`}
  >
    <input type="hidden" name="service" value={service} />
    <!-- Honeypot: bots fill it, people never see it -->
    <p class="visually-hidden" aria-hidden="true">
      <label>Leave this field empty<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
    </p>

    {fields.map((field, i) =>
      field.kind === 'choice' ? (
        <fieldset class="field field--choice" data-step={i}>
          <legend class="label">{field.label}</legend>
          {field.hint && <p class="hint">{field.hint}</p>}
          <div class="choices">
            {field.options.map((opt) => (
              <label class="choice">
                <input type="radio" name={field.name} value={opt} required={field.required} />
                <span>{opt}</span>
              </label>
            ))}
          </div>
        </fieldset>
      ) : field.kind === 'textarea' ? (
        <div class="field" data-step={i}>
          <label class="label" for={`${id}-${field.name}`}>{field.label}</label>
          {field.hint && <p class="hint" id={`${id}-${field.name}-hint`}>{field.hint}</p>}
          <textarea
            class="textarea" id={`${id}-${field.name}`} name={field.name}
            placeholder={field.placeholder} required={field.required}
            aria-describedby={field.hint ? `${id}-${field.name}-hint` : undefined}
          ></textarea>
        </div>
      ) : (
        <div class="field" data-step={i}>
          <label class="label" for={`${id}-${field.name}`}>{field.label}</label>
          {field.hint && <p class="hint" id={`${id}-${field.name}-hint`}>{field.hint}</p>}
          <input
            class="input" type={field.kind} id={`${id}-${field.name}`} name={field.name}
            placeholder={field.placeholder} required={field.required}
            autocomplete={field.kind === 'email' ? 'email' : field.kind === 'tel' ? 'tel' : 'on'}
            aria-describedby={field.hint ? `${id}-${field.name}-hint` : undefined}
          />
        </div>
      )
    )}

    {!live && (
      <p class="staged" id={`${id}-staged`}>
        <span aria-hidden="true">●</span>
        <span>
          <strong>Staged, not sending.</strong> This form is built and ready; no
          handler is connected yet, so nothing leaves this page. Leon connects one
          when he's ready — see <code>FORMS.md</code>.
        </span>
      </p>
    )}

    <p class="form__error" role="alert" hidden></p>

    <div>
      <button class="btn" type="submit" aria-disabled={live ? undefined : 'true'} disabled={!live}>
        <span class="dot" aria-hidden="true"></span><span class="btn__label">{submitLabel}</span>
      </button>
    </div>
  </form>

  <!-- Shown in place of the form on success. No page load: a redirect to the
       provider's own thank-you page costs a navigation and dumps the visitor
       on someone else's branding. -->
  <div class="quote__done" role="status" aria-live="polite" tabindex="-1" hidden>
    <p class="eyebrow">Sent</p>
    <h3>Thanks — that reached us.</h3>
    <p>
      It goes straight to Leon, and you will get a real answer rather than an
      auto-reply. If it is urgent, the phone number in the footer is the fastest route.
    </p>
  </div>
</div>

<script>
  /* Two enhancements, both optional. With JavaScript off the forms still work:
     the browser POSTs natively to the provider and lands on its thank-you page.
     With it on, nothing navigates. */
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLFormElement>('.quote form').forEach((form) => {
    /* 1. Auto-advance: choosing a radio moves focus to the next question.
          Saves a scroll and a tap per answer. */
    const steps = Array.from(form.querySelectorAll<HTMLElement>('[data-step]'));
    form.addEventListener('change', (event) => {
      const target = event.target as HTMLInputElement;
      if (target.type !== 'radio') return;
      const current = target.closest<HTMLElement>('[data-step]');
      if (!current) return;
      const next = steps[steps.indexOf(current) + 1];
      if (!next) return;
      const control = next.querySelector<HTMLElement>('input, textarea, select');
      if (!control) return;
      window.setTimeout(() => {
        control.focus({ preventScroll: true });
        if (!prefersReduced) next.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }, 90);
    });

    /* 2. Submit in place. Only when an endpoint exists — while the site is
          staged there is nothing to post to and the button is disabled. */
    const endpoint = form.dataset.endpoint;
    if (!endpoint) return;

    const panel = form.closest('.quote');
    const done = panel?.querySelector<HTMLElement>('.quote__done');
    const error = form.querySelector<HTMLElement>('.form__error');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const label = button?.querySelector<HTMLElement>('.btn__label');
    const labelText = label?.textContent ?? '';

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      /* Honeypot: bots fill it, people never see it. Pretend success rather
         than telling the bot it was caught. */
      const trap = form.querySelector<HTMLInputElement>('[name="_gotcha"]');
      if (trap?.value) { form.hidden = true; if (done) { done.hidden = false; } return; }

      if (error) error.hidden = true;
      if (button) button.disabled = true;
      if (label) label.textContent = 'Sending…';

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!response.ok) throw new Error(`${response.status}`);
        form.hidden = true;
        if (done) {
          done.hidden = false;
          /* After paint — focusing an element the browser has not laid out yet
             silently does nothing. */
          requestAnimationFrame(() => done.focus());
        }
      } catch {
        /* Never swallow it. A form that silently fails loses the enquiry and
           the visitor never knows — worse than an error they can act on. */
        if (error) {
          error.textContent =
            'That did not send. Please try again, or email us directly — the address is in the footer.';
          error.hidden = false;
        }
        if (button) button.disabled = false;
        if (label) label.textContent = labelText;
      }
    });
  });
</script>

<style>
  .quote {
    background: var(--slate);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 1rem + 2vw, 2.6rem);
    box-shadow: var(--shadow);
    scroll-margin-top: 90px;
  }
  .quote__head { margin-bottom: 1.9rem; }
  .quote__head h2 { font-size: var(--step-2); }
  .quote__head .lede { font-size: var(--step-0); margin-top: .7rem; }
  fieldset.field { border: 0; padding: 0; margin: 0; }
  legend.label { padding: 0; }
  code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .92em; }

  .form__error {
    border: 1.5px solid var(--signal);
    border-radius: var(--radius-sm);
    background: rgba(255, 77, 79, 0.09);
    color: var(--chalk);
    padding: .85rem 1rem;
    font-size: var(--step--1);
    margin: 0;
  }
  .quote__done { padding: .5rem 0; }
  .quote__done h3 { font-size: var(--step-2); margin-top: .7rem; }
  .quote__done p:last-child { margin-top: .9rem; color: var(--ash); }
  .quote__done:focus { outline: none; }
  .quote__done:focus-visible { outline: 3px solid var(--signal); outline-offset: 6px; }
</style>
