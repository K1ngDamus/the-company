---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, IS_CANONICAL, link as url, abs } from '../data/site';

interface Props {
  title: string;          // focused-keyword page title (SEO basics, §5)
  description: string;    // meta description
  path: string;           // canonical path, leading slash
  jsonLd?: object[];      // page-specific structured data
  phoneForward?: boolean; // feature the phone in the header (TV pages)
}
const { title, description, path, jsonLd = [], phoneForward = false } = Astro.props;
const canonical = abs(path);
const ogImage = abs('/brand/FPC-appicon-tile.svg');

/* Organization data sits on every page — one identity, stated once, everywhere. */
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  legalName: SITE.legalName,
  url: SITE.url,
  logo: ogImage,
  description: SITE.summary,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* A preview build is not the site. Keep it out of the index entirely so
        it can never outrank, duplicate, or stand in for frontporchco.com. */}
    {!IS_CANONICAL && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url("/brand/FPC-appicon-tile.svg")} />
    <meta name="theme-color" content="#0F0F11" />

    <link rel="preload" href={url("/fonts/jost-latin-var.woff2")} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={url("/fonts/playfair-display-latin-var.woff2")} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    {jsonLd.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header phoneForward={phoneForward} current={path} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
